/*
===============================================================================
Stored Procedure: silver.load_silver
===============================================================================

Script Purpose:
    This stored procedure loads cleaned and transformed data from the Bronze
    layer into the Silver layer of the Data Warehouse.

    The procedure performs a full refresh of the Silver customer table by:
        1. Truncating the existing Silver table.
        2. Reading raw customer data from the Bronze layer.
        3. Removing NULL customer IDs.
        4. Identifying duplicate customer records using ROW_NUMBER().
        5. Keeping the latest customer record based on creation date.
        6. Removing unwanted spaces using TRIM().
        7. Standardizing marital status and gender values.
        8. Inserting the cleaned data into the Silver table.

OBJECT / TABLE USED:
    Source:
        bronze.crm_cust_info

    Target:
        silver.crm_cust_info

MAIN TRANSFORMATIONS:
    - TRIM() is used to remove unwanted leading and trailing spaces.
    - UPPER() is used to standardize text comparisons.
    - CASE is used to standardize gender and marital-status values.
    - ROW_NUMBER() is used to identify duplicate customer records.
    - The latest record for each customer is retained based on cst_create_date.

WAREHOUSE METADATA:
    The target Silver table contains a dwh_create_date column with a default
    GETDATE() value to record when each row is loaded into the warehouse.

LOADING STRATEGY:
    Full Load using TRUNCATE + INSERT.

===============================================================================
WARNING:
    This procedure performs a FULL LOAD.

    Existing data in silver.crm_cust_info will be permanently removed using
    TRUNCATE TABLE before the transformed data is inserted.

    Make sure the Bronze layer has been successfully loaded and validated
    before executing this procedure.

    Verify all transformation rules before using this procedure in a
    production environment.
===============================================================================
*/



  
    CREATE OR ALTER PROCEDURE silver.load_silver AS
    BEGIN

    PRINT '>> TRUNCATING TABLE: silver.crm_cust_info';
    TRUNCATE TABLE silver.crm_csut_info;
    PRINT '>>INSERTING DATA INTO: SILVER.CRM_CUST_INFO'
    INSERT INTO silver.crm_cust_info
    (
        cst_id,
        cst_key,
        cst_firstname,
        cst_lastname,
        cst_material_status,
        cst_gndr,
        cst_create_date
    )
    SELECT
        cst_id,
        cst_key,
        TRIM(cst_firstname) AS cst_firstname,
        TRIM(cst_lastname) AS cst_lastname,

        CASE
            WHEN UPPER(TRIM(cst_material_status)) = 'M' THEN 'MARRIED'
            WHEN UPPER(TRIM(cst_material_status)) = 'S' THEN 'SINGLE'
            ELSE 'N/A'
        END AS cst_material_status,

        CASE
            WHEN UPPER(TRIM(cst_gndr)) = 'M' THEN 'MALE'
            WHEN UPPER(TRIM(cst_gndr)) = 'F' THEN 'FEMALE'
            ELSE 'N/A'
        END AS cst_gndr,

        cst_create_date

    FROM
    (
        SELECT
            *,
            ROW_NUMBER() OVER
            (
                PARTITION BY cst_id
                ORDER BY cst_create_date DESC
            ) AS flag_last
        FROM bronze.crm_cust_info
        WHERE cst_id IS NOT NULL
    ) t
    WHERE flag_last = 1;
END
